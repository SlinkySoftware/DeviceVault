# DeviceVault push receiver configuration. Copy to receiver.env and edit.
# Any variable can be supplied as a file instead by setting <NAME>_FILE.
# The receiver uses host networking, so these addresses are as seen from the host.

# --- Required -----------------------------------------------------------------
DV_BROKER_URL=amqp://devicevault:change-me@infra.example.net:5672//
DV_REDIS_URL=redis://:change-me@infra.example.net:6379/0

# --- Optional -----------------------------------------------------------------
DV_WORKER_NAME=receiver-dmz
DV_LOG_LEVEL=INFO
