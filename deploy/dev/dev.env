# Development-only settings. Never use these values in a deployment.

DV_DEBUG=true
DV_SECRET_KEY=insecure-development-key
DV_TIMEZONE=Australia/Sydney
DV_LOG_LEVEL=INFO

# Fixed development signing key; workers in the dev stack pin it.
DV_SIGNING_KEY=ZGV2ZWxvcG1lbnQtb25seS1zaWduaW5nLWtleS0zMiE=
# Fixed development data and vault keys. Payload encryption is off so queues
# and Redis stay readable; set DV_PAYLOAD_ENCRYPTION=true to try it.
DV_DATA_KEYS=dev=ZGV2ZWxvcG1lbnQtb25seS1kYXRhLWtleS0zMi1ieSE=
DV_VAULT_KEYS=dev=ZGV2ZWxvcG1lbnQtb25seS12YXVsdC1rZXktMzItYiE=
DV_PAYLOAD_ENCRYPTION=false
# Config search is opt-in for deployments; on here so it can be tried.
DV_CONFIG_SEARCH=true

DV_ADMIN_USERNAME=admin
DV_ADMIN_PASSWORD=admin

DV_DB_ENGINE=postgres
DV_DB_HOST=postgres
DV_DB_NAME=devicevault
DV_DB_USER=devicevault
DV_DB_PASSWORD=devicevault

DV_BROKER_URL=amqp://devicevault:devicevault@rabbitmq:5672//
DV_REDIS_URL=redis://:devicevault@redis:6379/0
DV_BROKER_API=http://devicevault:devicevault@rabbitmq:15672/api/

HOME=/tmp
