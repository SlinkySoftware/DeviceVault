# DeviceVault worker configuration. Copy to worker.env and edit.
# Any variable can be supplied as a file instead by setting <NAME>_FILE.

# --- Required -----------------------------------------------------------------
DV_BROKER_URL=amqp://devicevault:change-me@host.docker.internal:5672//
DV_REDIS_URL=redis://:change-me@host.docker.internal:6379/0

# --- Optional -----------------------------------------------------------------
DV_WORKER_NAME=collector-dmz
DV_WORKER_CONCURRENCY=2
DV_LOG_LEVEL=INFO

# --- Interim settings, removed when the orchestrator assigns work (phase 4) ---
# Collector: one or more collection group queues (collector.group.<queue id>)
DV_WORKER_QUEUES=collector.group.dmz_zone_queue
# Storage worker instead:
# DV_WORKER_QUEUES=storage.fs,storage.git

# Storage workers only, until collector-side encryption replaces it (phase 5)
# DV_ENCRYPTION_KEYS=mk-1=<base64 32-byte key>
# DV_ENCRYPTION_DEFAULT_KID=mk-1
