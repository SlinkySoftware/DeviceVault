# DeviceVault orchestrator configuration. Copy to orchestrator.env and edit.
# Any variable can be supplied as a file instead by setting <NAME>_FILE.

# --- Core ---------------------------------------------------------------------
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DV_SECRET_KEY=change-me
DV_DEBUG=false
# Hostnames the UI is served on (comma separated)
DV_ALLOWED_HOSTS=devicevault.example.com
# Full origins, required when the UI is served over HTTPS by a front proxy
DV_CSRF_TRUSTED_ORIGINS=https://devicevault.example.com
DV_TIMEZONE=Australia/Sydney
DV_LOG_LEVEL=INFO

# --- Keys (share them across orchestrator nodes) -----------------------------
# Generate all three:
#   docker run --rm -e DV_DEBUG=true --entrypoint python ghcr.io/slinkysoftware/devicevault-orchestrator manage.py generate_keys
# Signs every assignment and task sent to workers; workers pin it when first
# approved, so set it once and never change it.
DV_SIGNING_KEY=change-me
# Encrypt credentials and location config in the database (kid=<base64>, first is current).
DV_DATA_KEYS=change-me
# Encrypt backups and device credentials between orchestrator, workers, RabbitMQ
# and Redis. Collectors encrypt backups to the vault key; only the orchestrator
# can decrypt them. Keep old vault keys in the ring (after the current one)
# while backups encrypted with them remain.
DV_PAYLOAD_ENCRYPTION=true
DV_VAULT_KEYS=change-me

# --- Bootstrap admin (created by the migrate service if it does not exist, as a
# member of the built-in Administrators group) ---------------------------------
DV_ADMIN_USERNAME=admin
DV_ADMIN_PASSWORD=change-me
DV_ADMIN_EMAIL=

# --- Database -----------------------------------------------------------------
# sqlite: single orchestrator node, stored in the "data" volume.
# postgres: required for more than one orchestrator node.
DV_DB_ENGINE=sqlite
# DV_DB_ENGINE=postgres
# DV_DB_HOST=host.docker.internal
# DV_DB_PORT=5432
# DV_DB_NAME=devicevault
# DV_DB_USER=devicevault
# DV_DB_PASSWORD=change-me

# --- Message bus (see deploy/infra) -------------------------------------------
DV_BROKER_URL=amqp://devicevault:change-me@host.docker.internal:5672//
DV_REDIS_URL=redis://:change-me@host.docker.internal:6379/0
# RabbitMQ management API, used by Flower's queue views
DV_BROKER_API=http://devicevault:change-me@host.docker.internal:15672/api/

# --- Authentication -----------------------------------------------------------
# Identity providers (LDAP, OIDC) are set up in the UI: Admin Settings > Auth Providers.
# false: only break-glass local users (such as the bootstrap admin) sign in locally.
DV_LOCAL_AUTH_ENABLED=true
# Sessions end after this many idle minutes, and this many hours after sign-in.
DV_SESSION_IDLE_MIN=60
DV_SESSION_MAX_HOURS=12
# Failed sign-ins (per username and per client address) that lock out for the window.
DV_LOGIN_MAX_FAILURES=5
DV_LOGIN_LOCKOUT_MIN=15
# API tokens: the longest expiry allowed (days), and requests per token (<n>/sec, /min or /hour).
DV_API_TOKEN_MAX_DAYS=365
DV_API_TOKEN_RATE=600/min

# --- Retention ----------------------------------------------------------------
# Retention policies (Admin Settings > Retention Policies) are applied by the
# scheduler's leader this often, in minutes.
DV_RETENTION_INTERVAL_MIN=60

# --- Freshness ------------------------------------------------------------------
# A scheduled device is overdue once its latest successful backup is older than
# the gap between its schedule's runs times this (1.0 or more).
DV_STALE_FACTOR=1.5

# --- Config search --------------------------------------------------------------
# Search the latest backup of every device (DEPLOYMENT.md, Config search). It keeps
# that text in the database, with secret values only as keyed hashes, so it is off
# unless you turn it on.
DV_CONFIG_SEARCH=false
