# Rendered by the nginx image's envsubst step; only defined variables
# (DV_API_UPSTREAM, DV_RESOLVER) are substituted, so nginx's own $variables
# are preserved.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    # Relative redirects, so they keep whatever host and port the client used.
    absolute_redirect off;

    # Resolve the API at request time (Docker's DNS by default), so a recreated
    # api container with a new address is picked up without restarting nginx.
    resolver ${DV_RESOLVER} valid=10s ipv6=off;
    set $devicevault_api http://${DV_API_UPSTREAM};

    client_max_body_size 64m;

    location ~ ^/(api|admin|static)/ {
        proxy_pass $devicevault_api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 120s;
    }

    # Flower dashboards (Admin Settings > Flower). The API authorises each
    # request from the session cookie the UI sets for that endpoint and names
    # the upstream to use; Flower runs with --url_prefix=flower/<slug>, so the
    # path is passed through unchanged.
    location ~ ^/flower/[a-z0-9-]+/ {
        auth_request /_flower_auth;
        auth_request_set $flower_upstream $upstream_http_x_flower_upstream;
        error_page 401 403 = @flower_denied;

        proxy_pass $flower_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Flower must not see the session cookie or any API credentials.
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
        proxy_read_timeout 120s;
    }

    location ~ ^/flower/[a-z0-9-]+$ {
        return 301 $uri/;
    }

    location = /_flower_auth {
        internal;
        proxy_pass $devicevault_api/api/flower-auth/;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    # No (or an expired) session: back to the Flower page, which opens a new one.
    location @flower_denied {
        return 302 /vaultadmin/flower;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
