FROM ghcr.io/astral-sh/uv:0.13.5 AS uv

FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=0 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH=/opt/venv/bin:$PATH

RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

COPY --from=uv /uv /usr/local/bin/uv

# Dependencies are installed into /opt/venv so the bind-mounted source tree
# at /workspace never contains a virtualenv.
COPY pyproject.toml uv.lock /tmp/build/
COPY orchestrator/pyproject.toml /tmp/build/orchestrator/
RUN cd /tmp/build && uv sync --frozen --all-packages --no-install-project \
    && rm -rf /tmp/build

WORKDIR /workspace/orchestrator
